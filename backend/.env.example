# Copy to .env and fill in as needed. All values here have safe defaults for
# local development if you don't create a .env at all.

# SQLite by default. Point at Postgres (e.g. Neon) for production:
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./soc_shield.db

# Generate a real secret for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional — leave blank to use mock threat-intel responses instead.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
